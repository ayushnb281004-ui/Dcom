import numpy as np
import matplotlib.pyplot as plt

t = np.linspace(0, 2*np.pi, 100)
x = np.sin(t)
y, d, s = [], [], 0

for a in x:
    b = 1 if a >= s else 0
    s += 0.2 if b else -0.2
    d.append(b)
    y.append(s)

plt.subplot(3,1,1)
plt.plot(t,x)
plt.title("Input Sine Wave")

plt.subplot(3,1,2)
plt.step(t,y)
plt.title("Staircase Signal")

plt.subplot(3,1,3)
plt.step(t,d)
plt.title("Delta Modulated Output")

plt.tight_layout()
plt.show()
